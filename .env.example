# Copie este archivo como .env y ajuste los valores (nunca suba .env a GitHub).
# La aplicación lee variables de entorno; en Windows PowerShell:  $env:SECRET_KEY="..."

# SQLite para desarrollo (por defecto) o PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://usuario:clave@localhost:5432/recursos_tecnologicos
DATABASE_URL=sqlite:///./recursos_tecnologicos.db

SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria-de-32-caracteres-o-mas
ACCESS_TOKEN_MINUTES=60

# Administrador inicial (se crea solo la primera vez)
ADMIN_EMAIL=admin@umb.local
ADMIN_PASSWORD=Admin12345!

# Parámetros del análisis
HORAS_OPERATIVAS_DIA=14
UMBRAL_UTILIZACION_ALTA=0.80
UMBRAL_UTILIZACION_BAJA=0.10
